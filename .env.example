# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Your Supabase project URL (e.g. https://abcdefghij.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase project's anonymous/public key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional ─────────────────────────────────────────────────────────────────
# Service role key — only needed for admin scripts / migrations outside the app
# NEVER expose this key in client-side code
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
